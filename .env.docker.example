APP_NAME=Farmer IC
APP_URL=http://localhost:8080

# Database (PostgreSQL is used when running with compose.rag.yaml)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
POSTGRES_DB=farmer_ic
POSTGRES_USER=farmer_ic
POSTGRES_PASSWORD=secret

# AI / OpenRouter (server-side only; leave empty until a key is configured)
OPENROUTER_API_KEY=
AI_PRIMARY_MODEL=google/gemini-3.8-flash
AI_TEXT_FALLBACK_MODELS=google/gemini-3.7-flash,openai/gpt-6-luna
AI_VISION_FALLBACK_MODELS=google/gemini-3.7-flash,inclusionai/ling-3.0-flash-vl
# Optional low-latency profile. Keep disabled until a live quality/latency
# comparison confirms the selected model for this deployment.
AI_FAST_TEXT_MODEL=
AI_PREFER_FAST_TEXT_MODEL=false
# Keep text completions bounded for responsive chat; raise only after measuring p95.
AI_RESPONSE_MAX_OUTPUT_TOKENS=1024
# Optional provider-specific reasoning budget (none|minimal|low|medium|high).
AI_REASONING_EFFORT=
AI_STT_MODEL=qwen/qwen3.8-omni-flash
AI_STT_FALLBACK_MODELS=google/gemini-3.8-flash
AI_TTS_MODEL=
AI_TTS_VOICE=
AI_VOICE_ENABLED=true

# RAG demo vertical slice
AI_RAG_ENABLED=true
AI_RAG_RETRIEVAL_ENABLED=true
AI_RAG_SHADOW_MODE=false
# Enable after the P2 golden citation gate passes in a canary environment.
AI_RAG_REQUIRE_CITATIONS=false
AI_RAG_VECTOR_MIN_SCORE=0.30
AI_RAG_VECTOR_CANDIDATE_K=12
AI_RAG_VECTOR_SEMANTIC_WEIGHT=0.85

# P1 vector retrieval (compose.rag.yaml enables it by default; set false to disable)
AI_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_CACHE_ENABLED=true
AI_EMBEDDING_CACHE_TTL=600
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=farmer_ic_knowledge
QDRANT_API_KEY=
# Local-only overrides for compose.rag.yaml
QDRANT_PORT=6333
QDRANT_IMAGE=qdrant/qdrant:v1.14.1

# The entrypoint generates APP_KEY for local Docker runs when it is absent.
