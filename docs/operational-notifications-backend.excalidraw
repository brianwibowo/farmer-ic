    {
      "id": "60253b8a04f544699731",
      "type": "text",
      "x": 5172,
      "y": 1764.2,
      "width": 1496,
      "height": 130.0,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "30c0af4d8bdd4f448ea0"
      ],
      "frameId": "6f217ca7c46c4a1c9830",
      "roundness": null,
      "seed": 264,
      "version": 1,
      "versionNonce": 264,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "App\\Models\\Notification adalah baris inbox yang tersimpan.\nDailyReportNotification / HarvestReminderNotification adalah objek pesan.\n\nBelum dibaca: seluruh tanggal tanpa filter. Semua: filter tanggal + tenant Owner.\nMembuka detail tidak memanggil markRead(); tombol Tandai dibaca memanggil PATCH.",
      "originalText": "App\\Models\\Notification adalah baris inbox yang tersimpan.\nDailyReportNotification / HarvestReminderNotification adalah objek pesan.\n\nBelum dibaca: seluruh tanggal tanpa filter. Semua: filter tanggal + tenant Owner.\nMembuka detail tidak memanggil markRead(); tombol Tandai dibaca memanggil PATCH.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
    {
      "id": "a66da005c7d8466c91b6",
      "type": "text",
      "x": 3515,
      "y": 2090,
      "width": 3150,
      "height": 57.2,
