    },
    {
      "id": "a3d439305c164b93a584",
      "type": "text",
      "x": 92,
      "y": 4024.2,
      "width": 1456,
      "height": 156.0,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "1238436fe4df4733b812"
      ],
      "frameId": "708446a603334eaf94d1",
      "roundness": null,
      "seed": 321,
      "version": 1,
      "versionNonce": 321,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Kelas notification menyimpan snapshot dan membangun kedua format teks.\nLaravel memproses channel in-app sebagai queued notification.\nJob WhatsApp memanggil client HTTP dan mengatur retry provider.\n\nDua kanal dijadwalkan terpisah. Kegagalan WhatsApp tidak mengharuskan\npengulangan insert in-app.",
      "originalText": "Kelas notification menyimpan snapshot dan membangun kedua format teks.\nLaravel memproses channel in-app sebagai queued notification.\nJob WhatsApp memanggil client HTTP dan mengatur retry provider.\n\nDua kanal dijadwalkan terpisah. Kegagalan WhatsApp tidak mengharuskan\npengulangan insert in-app.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
