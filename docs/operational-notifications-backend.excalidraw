    {
      "id": "fde3f6dc277f4b3d81e2",
      "type": "text",
      "x": 1242,
      "y": 1684.2,
      "width": 856,
      "height": 286.0,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "83049f564212426b8242"
      ],
      "frameId": "8fa54397815246179304",
      "roundness": null,
      "seed": 200,
      "version": 2,
      "versionNonce": 200,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793529553217,
      "link": null,
      "locked": false,
      "text": "RolePermissions (panel 02): withMembershipSnapshot().\nDaily: lazyById(100), with(role, teams).\nAktivitas batch per penerima/tenant, groupBy(farm_id).\nPanen: with(role, teams, assignedFarm.team).\nTiga tanggal dalam satu query; cycle memakai farm tersimpan.\n\nDB::afterCommit(): User::notify() + Job::dispatch().\nChannel/Job memanggil validRecipient() memakai data terbaru.\nWA nonaktif / waktu tidak cukup: skip sebelum query.\nSesudah /validate: baca ulang membership, role, dan jadwal.\nSnapshot membership dihapus via finally; bukan cache lintas job.",
      "originalText": "RolePermissions (panel 02): withMembershipSnapshot().\nDaily: lazyById(100), with(role, teams).\nAktivitas batch per penerima/tenant, groupBy(farm_id).\nPanen: with(role, teams, assignedFarm.team).\nTiga tanggal dalam satu query; cycle memakai farm tersimpan.\n\nDB::afterCommit(): User::notify() + Job::dispatch().\nChannel/Job memanggil validRecipient() memakai data terbaru.\nWA nonaktif / waktu tidak cukup: skip sebelum query.\nSesudah /validate: baca ulang membership, role, dan jadwal.\nSnapshot membership dihapus via finally; bukan cache lintas job.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
    {
      "id": "fe408f32213949dfb650",
      "type": "text",
      "x": 55,
      "y": 2090,
      "width": 3150,
      "height": 57.2,
      "angle": 0,
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "8fa54397815246179304",
      "roundness": null,
      "seed": 201,
      "version": 1,
      "versionNonce": 201,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Pemicu: routes/console.php → schedule command 20:00 / 06:00 WIB. Command juga bisa dipanggil manual.\nQueue worker menjalankan queued notification dan job; constructor memakai afterCommit().",
      "originalText": "Pemicu: routes/console.php → schedule command 20:00 / 06:00 WIB. Command juga bisa dipanggil manual.\nQueue worker menjalankan queued notification dan job; constructor memakai afterCommit().",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
