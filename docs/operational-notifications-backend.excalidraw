    {
      "id": "ece185b91ef04184a26b",
      "type": "text",
      "x": 5162,
      "y": 4124.2,
      "width": 1506,
      "height": 208.0,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "74963c4889b64c53a0c5"
      ],
      "frameId": "a8b3472fb6ba484ab34c",
      "roundness": null,
      "seed": 406,
      "version": 2,
      "versionNonce": 406,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793529553217,
      "link": null,
      "locked": false,
      "text": "Service menggunakan Gate::forUser(recipient).\nDaily: Owner/Admin; panen: Petugas dengan assignment valid.\nSemua penerima harus aktif, punya membership dan izin baca.\nwithMembershipSnapshot(): satu callback; dibuang via finally.\nDispatcher: reload=false hanya untuk batch eager-load baru.\nvalidRecipient(): user, role, membership, farm/jadwal terbaru.\nSesudah /validate, validRecipient() dipanggil kembali.\nNomor telepon hanya memengaruhi job WhatsApp.",
      "originalText": "Service menggunakan Gate::forUser(recipient).\nDaily: Owner/Admin; panen: Petugas dengan assignment valid.\nSemua penerima harus aktif, punya membership dan izin baca.\nwithMembershipSnapshot(): satu callback; dibuang via finally.\nDispatcher: reload=false hanya untuk batch eager-load baru.\nvalidRecipient(): user, role, membership, farm/jadwal terbaru.\nSesudah /validate, validRecipient() dipanggil kembali.\nNomor telepon hanya memengaruhi job WhatsApp.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
    {
      "id": "0de09b94cf814ce189da",
      "type": "text",
      "x": 3515,
      "y": 4440,
      "width": 3150,
      "height": 57.2,
      "angle": 0,
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "a8b3472fb6ba484ab34c",
      "roundness": null,
      "seed": 407,
      "version": 1,
      "versionNonce": 407,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Snapshot menyimpan ID penerima / tenant / kebun / siklus. Queue job bukan pemberi akses baru.\nPanel ini hanya menampilkan model yang relevan dengan notifikasi; bukan seluruh ERD proyek.",
      "originalText": "Snapshot menyimpan ID penerima / tenant / kebun / siklus. Queue job bukan pemberi akses baru.\nPanel ini hanya menampilkan model yang relevan dengan notifikasi; bukan seluruh ERD proyek.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 22
    },
