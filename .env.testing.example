APP_ENV=testing
DB_CONNECTION=pgsql_testing
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_DATABASE=farmer_ic_crud_test_suite
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=

# Use a dedicated PostgreSQL account/server for CI. If this file is not copied
# to .env.testing, local tests inherit server credentials from .env and still
# use the separate TEST_DB_DATABASE above. No application tables are reset.
