farmer-ic.duckdns.org {
    @ai_stream path_regexp ai_stream ^/[^/]+/ai/(messages|conversations/[^/]+/messages)$

    handle @ai_stream {
        reverse_proxy app:80 {
            flush_interval -1
            transport http {
                read_timeout 0s
                write_timeout 0s
            }
        }
    }

    header @ai_stream {
        Cache-Control "no-cache, no-transform"
        X-Accel-Buffering "no"
    }

    encode gzip
    reverse_proxy app:80
}
