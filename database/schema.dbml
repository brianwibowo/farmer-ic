Project FarmerIC {
  database_type: 'PostgreSQL'
  Note: 'Master ERD Farmer IC dengan dukungan teams untuk integrasi RAG. Tanpa farm_plots. Role aplikasi terpisah dari role anggota team.'
}

Table roles {
  id uuid [pk]
  name varchar(30) [not null, unique, note: 'owner | superadmin | admin | petugas; superadmin is the developer Gate::before role']
  description text
}

Table users {
  id uuid [pk]
  role_id uuid [not null, ref: > roles.id]
  name varchar(150) [not null]
  email varchar(255) [not null, unique]
  password text [not null]
  avatar_url text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz
  current_team_id bigint [ref: > teams.id]
  email_verified_at timestamp
  two_factor_secret text
  two_factor_recovery_codes text
  two_factor_confirmed_at timestamp
  remember_token varchar(100)
  assigned_farm_id uuid [ref: > farms.id, note: 'Direct one-farm assignment for petugas; nullable for owner/admin']
  deleted_at timestamp
  phone_number varchar(15) [note: 'Nullable canonical international digits, e.g. 62812; normalized from +6208/08 at validated HTTP boundaries']
}

Table teams {
  id bigint [pk, increment]
  name varchar(255) [not null]
  slug varchar(255) [not null, unique]
  is_personal boolean [not null, default: false]
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table team_members {
  id bigint [pk, increment]
  team_id bigint [not null, ref: > teams.id]
  user_id uuid [not null, ref: > users.id]
  role varchar(255) [not null, note: 'Role anggota team; terpisah dari users.role_id']
  created_at timestamptz
  updated_at timestamptz

  indexes {
    (team_id, user_id) [unique]
  }
}

Table team_invitations {
  id bigint [pk, increment]
  code varchar(64) [not null, unique]
  team_id bigint [not null, ref: > teams.id]
  email varchar(255) [not null]
  role varchar(255) [not null]
  invited_by uuid [not null, ref: > users.id]
  expires_at timestamptz
  accepted_at timestamptz
  created_at timestamptz
  updated_at timestamptz
}

Table administrative_regions {
  code varchar(8) [pk]
  name varchar(100) [not null]
  level smallint [not null]
  parent_code varchar(8) [ref: > administrative_regions.code]
  indexes {
    level
    parent_code
  }
  Note: 'Snapshot wilayah administratif Indonesia: provinsi, kabupaten/kota, kecamatan.'
}

Table farms {
  id uuid [pk]
  owner_id uuid [ref: > users.id, note: 'Pemilik kebun; bukan akun yang membuat data']
  created_by uuid [not null, ref: > users.id]
  name varchar(150) [not null]
  address text
  city varchar(100)
  district varchar(100)
  province varchar(100)
  total_area_ha decimal(12,4) [not null, note: 'CHECK > 0']
  latitude decimal(10,7)
  longitude decimal(10,7)
  image_url text
  created_at timestamptz [not null]
  updated_at timestamptz
  team_id bigint [ref: > teams.id, note: 'Tenant boundary; nullable during staged data migration, but authorization denies farms without a team']
  land_tenure varchar(20) [note: 'owned | rented | partnership; null for legacy farms until confirmed']
  district_code varchar(8) [ref: > administrative_regions.code]
  default_sop_template_id uuid [ref: > sop_templates.id, note: 'SOP default kebun; dipakai otomatis saat Petugas mencatat penanaman']
  commodity_id uuid [ref: > commodities.id, note: 'Komoditas kebun; dapat dipilih sebelum SOP tersedia']
  pic_user_id uuid [ref: > users.id, note: 'PIC opsional dari Admin tenant yang sama; ON DELETE SET NULL']
  target_volume_ton decimal(12,3) [note: 'Target volume opsional dalam ton; CHECK > 0']
  indexes {
    commodity_id
    pic_user_id
  }
  Note: 'Tanpa farm_plots. Jika semua owner memantau semua kebun, owner_id boleh dihilangkan.'
}

Table commodities {
  id uuid [pk]
  name varchar(100) [not null, unique]
  description text
  image_url text
}

Table crop_varieties {
  id uuid [pk]
  commodity_id uuid [not null, ref: > commodities.id]
  name varchar(150) [not null]
  description text
  indexes { (commodity_id, name) [unique] }
}

Table planting_cycles {
  id uuid [pk]
  farm_id uuid [not null, ref: > farms.id]
  variety_id uuid [ref: > crop_varieties.id, note: 'Nullable only for a zero-area preparation batch']
  planted_at date [note: 'Nullable only for a zero-area preparation batch']
  estimated_harvest_at date
  planted_area_ha decimal(12,4) [not null, note: 'Positive, or zero for planned preparation batches; never exceeds reserved area']
  estimated_weight_ton decimal(14,3)
  status varchar(30) [not null, note: 'planned | active | harvested | cancelled']
  created_at timestamptz [not null]
  batch_number int
  subblock_label varchar(30)
  reserved_area_ha decimal(12,4)
  created_by uuid [ref: > users.id]
  planned_planting_at date [note: 'Rencana tanggal tanam; acuan HST untuk jadwal tugas sebelum realisasi tanam']
  sop_template_version_id uuid [ref: > sop_template_versions.id, note: 'Snapshot versi SOP yang dipakai subblok ini']
  planting_started_on date [note: 'Tanggal tanam pertama pada window tiga hari; acuan audit rekonsiliasi']
  planting_window_checked_at timestamptz [note: 'Waktu command rekonsiliasi menutup window penanaman']
  block_id uuid [ref: > farm_blocks.id, note: 'Direct block ownership; null only for legacy cycles']
  indexes {
    (farm_id, batch_number) [unique]
  }
  Note: 'Satu kebun dapat memiliki banyak siklus tanam.'
}

Table farm_blocks {
  id uuid [pk]
  farm_id uuid [not null, ref: > farms.id]
  code varchar(30) [not null]
  name varchar(150) [not null]
  area_ha decimal(12,4) [not null]
  description text
  is_active boolean [not null, default: true]
  created_by uuid [not null, ref: > users.id]
  land_clearing_started_at timestamptz [not null]
  land_clearing_completed_at timestamptz
  created_at timestamptz
  updated_at timestamptz
  indexes {
    (farm_id, code) [unique]
    (id, farm_id) [unique]
  }
  Note: 'Active block areas fit within the farm. First batch automatically completes Land Clearing. Historical blocks are deactivated rather than deleted.'
}

Table planting_cycle_stages {
  id uuid [pk]
  planting_cycle_id uuid [not null, ref: > planting_cycles.id]
  code varchar(30) [not null]
  position int [not null]
  status varchar(30) [not null]
  started_at timestamptz
  completed_at timestamptz
  created_at timestamptz
  updated_at timestamptz
  indexes {
    (id, planting_cycle_id) [unique]
    (planting_cycle_id, code) [unique]
    (planting_cycle_id, position) [unique]
  }
  Note: 'Six stages per new batch: land_clearing completed, soil_preparation in_progress, remaining stages upcoming. No fabricated dates or progress percentages.'
}

Table planting_cycle_tasks {
  id uuid [pk]
  planting_cycle_id uuid [not null, ref: > planting_cycles.id]
  planting_cycle_stage_id uuid [not null, note: 'Composite FK to a stage of the same subblok']
  sop_template_task_id uuid [ref: > sop_template_tasks.id]
  activity_category varchar(30) [not null, note: 'maintenance | harvest; planting is the HST anchor, not a task']
  activity_subcategory varchar(50) [note: 'Wajib untuk maintenance']
  name varchar(200) [not null]
  instructions text
  offset_days int [not null, default: 0]
  tolerance_days int [not null, default: 0]
  scheduled_date date [note: 'Null when the subblok has no planted_at or planned_planting_at']
  due_date date
  is_required boolean [not null, default: true]
  status varchar(30) [not null, default: 'pending', note: 'pending | in_progress | completed | skipped; skipped means deliberately not done']
  completed_at timestamptz
  skip_reason text
  created_at timestamptz
  updated_at timestamptz
  rescheduled_date date [note: 'Admin override; original scheduled_date remains the SOP/HST target']
  reschedule_reason text
  rescheduled_by uuid [ref: > users.id]
  rescheduled_at timestamptz
  completed_by uuid [ref: > users.id]
  completion_note text
  indexes {
    (planting_cycle_id, sop_template_task_id) [unique]
    (id, planting_cycle_id) [unique]
    (planting_cycle_id, scheduled_date, status)
    (planting_cycle_id, offset_days)
    completed_by
  }
  Note: 'Snapshot of follow-up SOP tasks for one subblok. Planting steps are not materialized; planting is the HST anchor. Generated once per subblok + SOP version. Existing snapshots survive later SOP changes.'
}

Table sop_templates {
  id uuid [pk]
  copied_from_version_id uuid [ref: > sop_template_versions.id]
  name varchar(150) [not null]
  description text
  is_active boolean [not null, default: true]
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz
  updated_at timestamptz
  team_id bigint [not null, ref: > teams.id]
  commodity_id uuid [not null, ref: > commodities.id]
  indexes {
    (team_id, commodity_id)
    commodity_id
    copied_from_version_id
  }
  Note: 'Tenant-owned SOP template for one commodity. Variety does not select the SOP. A farm points to one of these templates as its default.'
}

Table sop_template_versions {
  id uuid [pk]
  sop_template_id uuid [not null, ref: > sop_templates.id]
  version int [not null]
  notes text
  status varchar(30) [not null, default: 'draft', note: 'draft | published | retired']
  created_by uuid [not null, ref: > users.id]
  published_by uuid [ref: > users.id]
  published_at timestamptz
  created_at timestamptz
  updated_at timestamptz
  indexes {
    (sop_template_id, version) [unique]
    (sop_template_id, status)
  }
  Note: 'Published versions and their tasks are frozen. Revision creates a new version; older published versions are retired.'
}

Table sop_template_tasks {
  id uuid [pk]
  sop_template_version_id uuid [not null, ref: > sop_template_versions.id]
  name varchar(200) [not null]
  instructions text
  offset_days int [not null, default: 0, note: 'HST dari tanggal tanam (planted_at, atau planned_planting_at bila belum tanam); SOP dimulai pada H+0']
  tolerance_days int [not null, default: 0, note: 'due_date = scheduled_date + tolerance_days']
  is_required boolean [not null, default: true]
  created_at timestamptz
  updated_at timestamptz
  activity_category varchar(30) [not null, note: 'maintenance | harvest; planting is the HST anchor, not an SOP step']
  activity_subcategory varchar(50) [note: 'Wajib untuk maintenance: irrigation | weeding | follow_up_fertilization | growth_check | pest_control']
  indexes {
    (sop_template_version_id, offset_days)
    (sop_template_version_id, activity_category)
    (sop_template_version_id, activity_subcategory)
  }
  Note: 'One row is one follow-up SOP step at one relative day. Ordered by offset_days, then category, creation time, and id. Planting is recorded by the planting activity and is not an SOP step.'
}

Table activity_types {
  id uuid [pk]
  code varchar(50) [not null, unique, note: 'kategori dan subkategori aktivitas']
  name varchar(100) [not null]
  description text
  parent_id uuid [ref: > activity_types.id, note: 'Null untuk kategori root; parent untuk subkategori']
  detail_key varchar(50) [note: 'Menentukan detail table; null jika detail belum tersedia']
  is_selectable boolean [not null, default: true, note: 'False untuk parent kategori dan block_mapping']
  sort_order smallint [not null, default: 0]
  is_active boolean [not null, default: true]
  indexes {
    parent_id
  }
  Note: 'Self-referencing taxonomy. Category = root, subcategory = child. Farm activities point to the most specific selectable row.'
}

Table farm_activities {
  id uuid [pk]
  farm_id uuid [not null, ref: > farms.id]
  planting_cycle_id uuid [ref: > planting_cycles.id]
  activity_type_id uuid [not null, ref: > activity_types.id]
  performed_by uuid [not null, ref: > users.id]
  activity_date timestamptz [not null]
  description text
  status varchar(30)
  created_at timestamptz [not null]
  updated_at timestamptz
  daily_activity_log_id uuid [note: 'Composite FK with farm_id to daily_activity_logs; nullable for earlier activities']
  position int
  obstacle_status varchar(30) [not null, default: 'not_recorded', note: 'not_recorded | none | reported']
  obstacles text
  proposed_solution text
  action_taken text
  planting_cycle_task_id uuid [note: 'Composite FK with planting_cycle_id; nullable for non-task activities']
  task_details jsonb [note: 'Validated task-specific measurements; required for task-linked reports. Weeding uses these details; other types also retain their existing typed detail.']
  worker_count int [note: 'Jumlah pekerja untuk aktivitas ini; nullable untuk data lama']
  block_id uuid [note: 'Nullable for farm-wide or unidentifiable legacy activities; derived from the cycle when present']
  Note: 'Block belongs to farm; when both block and cycle are present they must agree. Tipe aktivitas menentukan satu detail yang tepat; task-linked weeding uses task_details instead.'
}

Table daily_activity_logs {
  id uuid [pk]
  farm_id uuid [not null, ref: > farms.id]
  recorded_by uuid [not null, ref: > users.id, note: 'Pembuat pertama header bersama; pelaksana tiap aktivitas ada di farm_activities.performed_by']
  work_date date [not null]
  start_time time [not null]
  end_time time
  notes text
  created_at timestamptz [not null]
  updated_at timestamptz

  indexes {
    (id, farm_id) [unique]
    (farm_id, work_date) [unique]
  }
  Note: 'Satu header bersama per kebun per tanggal. Jam mulai wajib; jam selesai boleh menyusul. Jumlah pekerja disimpan per aktivitas dan menambah aktivitas tidak menimpa header.'
}

Ref: farm_activities.(daily_activity_log_id, farm_id) > daily_activity_logs.(id, farm_id)
Ref: farm_activities.(planting_cycle_task_id, planting_cycle_id) > planting_cycle_tasks.(id, planting_cycle_id)
Ref: farm_activities.(block_id, farm_id) > farm_blocks.(id, farm_id)

Table block_mapping_details {
  activity_id uuid [pk, ref: > farm_activities.id]
  form_version int [not null, default: 1]
  block_name varchar(100) [not null]
  length_m decimal(10,3) [not null]
  width_m decimal(10,3) [not null]
  row_spacing_cm decimal(8,2)
  plant_spacing_cm decimal(8,2)
  rows_per_bed int
  block_id uuid [ref: > farm_blocks.id, note: 'Must share the activity farm; historical measurement fields remain snapshots']
}

Table activity_photos {
  id uuid [pk]
  activity_id uuid [not null, ref: > farm_activities.id]
  label varchar(150)
  caption text
  image_url text [not null]
  uploaded_at timestamptz [not null]
}

Table planting_details {
  activity_id uuid [pk, ref: > farm_activities.id]
  seed_name varchar(150)
  quantity_kg decimal(12,3)
  planting_pattern varchar(150)
  area_ha decimal(12,4)
}

Table fertilization_details {
  activity_id uuid [pk, ref: > farm_activities.id]
  fertilization_stage varchar(100)
  fertilizer_type varchar(150)
  brand_name varchar(150)
  subsidy_status varchar(30)
  application_method varchar(150)
  quantity_kg decimal(12,3)
  area_ha decimal(12,4)
  quantity_unit varchar(20)
  sack_size_kg decimal(10,3)
  Note: 'Dipakai untuk pemupukan susulan dan pemupukan dasar; fertilization_stage membedakan dasar/susulan.'
}

Table irrigation_details {
  activity_id uuid [pk, ref: > farm_activities.id]
  water_source varchar(150)
  irrigation_method varchar(150)
  machine_type varchar(150)
  duration_hours decimal(8,2)
}

Table pesticide_details {
  activity_id uuid [pk, ref: > farm_activities.id]
  pesticide_category varchar(100)
  purpose varchar(100)
  brand_name varchar(150)
  active_ingredient varchar(150)
  dosage_per_tank varchar(100) [note: 'Text mempertahankan satuan dosis dari data demo']
  tank_size_liters decimal(8,2)
  tank_count int
}

Table incident_details {
  activity_id uuid [pk, ref: > farm_activities.id]
  incident_category varchar(150)
  severity varchar(30)
  affected_area_ha decimal(12,4)
  proposed_solution text
}

Table harvest_details {
  activity_id uuid [pk, ref: > farm_activities.id]
  harvested_area_ha decimal(12,4)
  gross_weight_ton decimal(14,3)
  moisture_percentage decimal(5,2)
  color varchar(100)
  ripeness varchar(150)
  cleanliness varchar(150)
}

Table land_cleaning_details {
  activity_id uuid [pk, ref: > farm_activities.id]
  area_ha decimal(12,4)
  method varchar(50)
  product_name varchar(150)
  dosage_per_tank varchar(100)
  water_liters decimal(8,2)
  tank_count int
}

Table loosening_details {
  activity_id uuid [pk, ref: > farm_activities.id]
  area_ha decimal(12,4)
  method varchar(50)
  depth_cm decimal(8,2)
}

Table weeding_details {
  activity_id uuid [pk, ref: > farm_activities.id]
  area_ha decimal(12,4)
  method varchar(50)
  depth_cm decimal(8,2)
}

Table bed_preparation_details {
  activity_id uuid [pk, ref: > farm_activities.id]
  bed_count int
  length_m decimal(10,3)
  width_m decimal(10,3)
  height_cm decimal(8,2)
  bed_spacing_cm decimal(8,2)
  area_ha decimal(12,4)
}

Table liming_details {
  activity_id uuid [pk, ref: > farm_activities.id]
  area_ha decimal(12,4)
  material_type varchar(100)
  brand_name varchar(150)
  quantity_value decimal(14,3)
  quantity_unit varchar(20)
  sack_size_kg decimal(10,3)
  application_method varchar(150)
}

Table other_details {
  activity_id uuid [pk, ref: > farm_activities.id]
  description text
  area_ha decimal(12,4)
}

Table plant_observations {
  id uuid [pk]
  planting_cycle_id uuid [not null, ref: > planting_cycles.id]
  activity_id uuid [unique, ref: > farm_activities.id, note: 'Opsional: pengamatan tercatat sebagai kegiatan growth_check; menggantikan growth_check_details']
  observed_by uuid [not null, ref: > users.id]
  observed_at timestamptz [not null]
  growth_phase varchar(100)
  average_height_cm decimal(8,2)
  disease_indication varchar(100)
  pest_indication varchar(100)
  health_status varchar(30)
  growth_percentage decimal(5,2)
  plant_condition text
  notes text
}

Table weather_records {
  id uuid [pk]
  farm_id uuid [not null, ref: > farms.id]
  recorded_at timestamptz [not null]
  condition varchar(100)
  temperature_c decimal(5,2)
  humidity_percentage decimal(5,2)
  data_source varchar(100)
}

Table farm_risks {
  id uuid [pk]
  planting_cycle_id uuid [not null, ref: > planting_cycles.id]
  observation_id uuid [ref: > plant_observations.id]
  risk_description text [not null]
  severity varchar(30)
  recommendation text
  status varchar(30)
  detected_at timestamptz [not null]
}

Table ai_insights {
  id uuid [pk]
  planting_cycle_id uuid [not null, ref: > planting_cycles.id]
  observation_id uuid [ref: > plant_observations.id]
  summary text
  next_step text
  confidence_score decimal(5,2)
  model_name varchar(100)
  generated_at timestamptz [not null]
}

Table financial_categories {
  id uuid [pk]
  name varchar(100) [not null]
  transaction_type varchar(20) [not null, note: 'income | expense']
  indexes { (name, transaction_type) [unique] }
}

Table financial_transactions {
  id uuid [pk]
  farm_id uuid [ref: > farms.id, note: 'Boleh kosong untuk transaksi lintas kebun']
  planting_cycle_id uuid [ref: > planting_cycles.id]
  category_id uuid [not null, ref: > financial_categories.id]
  recorded_by uuid [not null, ref: > users.id]
  transaction_date date [not null]
  transaction_type varchar(20) [not null, note: 'income | expense']
  amount decimal(18,2) [not null, note: 'CHECK > 0']
  description text
  created_at timestamptz [not null]
  Note: 'commodity_id dihapus untuk mengurangi redundansi; transaksi siklus mendapatkan komoditas via JOIN. Untuk transaksi per-komoditas tanpa siklus, perlu aturan tambahan.'
}

Table financial_projections {
  id uuid [pk]
  farm_id uuid [not null, ref: > farms.id]
  planting_cycle_id uuid [ref: > planting_cycles.id]
  period_start date [not null]
  period_end date [not null]
  projected_income decimal(18,2)
  projected_expense decimal(18,2)
  calculated_at timestamptz [not null]
}

Table financial_budgets {
  id uuid [pk]
  farm_id uuid [ref: > farms.id]
  category_id uuid [ref: > financial_categories.id]
  period_start date [not null]
  period_end date [not null]
  budget_amount decimal(18,2) [not null]
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
}

Table operational_targets {
  id uuid [pk]
  farm_id uuid [not null, ref: > farms.id]
  planting_cycle_id uuid [ref: > planting_cycles.id]
  task_name varchar(200) [not null]
  target_unit varchar(20) [not null, note: 'Ha | Ton | etc.']
  target_value decimal(14,3) [not null]
  completed_value decimal(14,3) [not null, default: 0]
  target_date date
  status varchar(30)
  created_by uuid [not null, ref: > users.id]
}

Table ai_conversations {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  title varchar(200)
  created_at timestamptz [not null]
  updated_at timestamptz
  team_id bigint [ref: > teams.id]
  status varchar(32) [not null, default: 'active']
  knowledge_snapshot jsonb
  last_message_at timestamptz
}

Table ai_messages {
  id uuid [pk]
  ai_conversation_id uuid [not null, ref: > ai_conversations.id]
  role varchar(20) [not null, note: 'user | assistant | system']
  content text
  model varchar(128)
  status varchar(32) [not null, default: 'completed']
  created_at timestamptz [not null]
  user_id uuid [ref: > users.id]
  provider varchar(64)
  request_id varchar(255)
  input_tokens int
  output_tokens int
  latency_ms int
  error_message text
  metadata jsonb
  updated_at timestamptz
}

Table ai_attachments {
  id uuid [pk]
  ai_message_id uuid [ref: > ai_messages.id]
  mime_type varchar(128)
  path text [not null]
  created_at timestamptz [not null]
  ai_conversation_id uuid [ref: > ai_conversations.id]
  user_id uuid [ref: > users.id]
  disk varchar(64) [not null, default: 'public']
  original_name varchar(255)
  size bigint
  sha256 varchar(64)
  kind varchar(32) [not null, default: 'image']
  status varchar(32) [not null, default: 'ready']
  metadata jsonb
  updated_at timestamptz
}

Table ai_knowledge_documents {
  id uuid [pk]
  title varchar(200) [not null]
  content text
  file_url text
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz
  team_id bigint [ref: > teams.id]
  reviewed_by uuid [ref: > users.id]
  status varchar(32) [not null, default: 'draft']
  source varchar(255)
  content_hash varchar(64)
  version int [not null, default: 1]
  published_at timestamptz
  locale varchar(16) [not null, default: 'id-ID']
  domain varchar(64)
  index_status varchar(32) [not null, default: 'pending']
  index_version varchar(64)
  indexed_at timestamptz
  index_error text
}

Table ai_usage_logs {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  message_id uuid [ref: > ai_messages.id, note: 'Nullable untuk pemakaian AI di luar chatbot']
  model_name varchar(100)
  input_tokens int
  output_tokens int
  estimated_cost decimal(18,8)
  created_at timestamptz [not null]
}

Table notifications {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  title varchar(200)
  message text
  is_read boolean [not null, default: false]
  created_at timestamptz [not null]
  read_at timestamptz
  type varchar(32) [note: 'daily_report or harvest_reminder; nullable for legacy non-operational entries']
  team_id bigint [ref: > teams.id, note: 'Nullable for legacy inbox entries whose tenant cannot be proven']
}

Table audit_logs {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  table_name varchar(100)
  record_id uuid
  action varchar(20)
  old_values jsonb
  new_values jsonb
  created_at timestamptz [not null]
}

Table ai_knowledge_chunks {
  id uuid [pk]
  ai_knowledge_document_id uuid [not null, ref: > ai_knowledge_documents.id]
  team_id bigint [not null, ref: > teams.id]
  chunk_index int [not null]
  content text [not null]
  content_hash varchar(64) [not null]
  chunking_version varchar(32) [not null]
  embedding_model varchar(128)
  qdrant_point_id varchar(128)
  token_count int
  metadata jsonb
  status varchar(32) [not null, default: 'pending']
  indexed_at timestamptz
  created_at timestamptz
  updated_at timestamptz
  indexes {
    (ai_knowledge_document_id, chunk_index, content_hash) [unique]
  }
}

Table ai_usage_events {
  id uuid [pk]
  team_id bigint [ref: > teams.id]
  user_id uuid [ref: > users.id]
  ai_conversation_id uuid [ref: > ai_conversations.id]
  ai_message_id uuid [ref: > ai_messages.id]
  provider varchar(64)
  model varchar(128)
  event_type varchar(64) [not null]
  request_id varchar(255)
  input_tokens int
  output_tokens int
  latency_ms int
  metadata jsonb
  created_at timestamptz
  updated_at timestamptz
}
