APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI / OpenRouter (the key is server-only and must never be exposed as a VITE variable)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL="${APP_URL}"
OPENROUTER_APP_NAME="${APP_NAME}"
# Optional enterprise alias or model ID approved for the OpenRouter account.
AI_ENTERPRISE_MODEL=
AI_PRIMARY_MODEL=google/gemini-3.8-flash
AI_TEXT_FALLBACK_MODELS=google/gemini-3.7-flash,openai/gpt-6-luna
AI_VISION_FALLBACK_MODELS=google/gemini-3.7-flash,inclusionai/ling-3.0-flash-vl
# Optional low-latency profile. Keep disabled until a live quality/latency
# comparison confirms the selected model for this deployment.
AI_FAST_TEXT_MODEL=
AI_PREFER_FAST_TEXT_MODEL=false
# Keep text completions bounded for responsive chat; raise only after measuring p95.
AI_RESPONSE_MAX_OUTPUT_TOKENS=1024
# Optional provider-specific reasoning budget (none|minimal|low|medium|high).
AI_REASONING_EFFORT=
AI_VOICE_ENABLED=true
AI_STT_MODEL=qwen/qwen3.8-omni-flash
AI_STT_FALLBACK_MODELS=google/gemini-3.8-flash
AI_TTS_MODEL=
AI_TTS_VOICE=

# RAG demo vertical slice (server-side retrieval over static/published knowledge)
AI_RAG_ENABLED=true
AI_RAG_RETRIEVAL_ENABLED=true
AI_RAG_SHADOW_MODE=false
# Enable after the P2 golden citation gate passes in a canary environment.
AI_RAG_REQUIRE_CITATIONS=false
AI_RAG_TOP_K=4
AI_RAG_MIN_EVIDENCE_SCORE=0.22
AI_RAG_VECTOR_MIN_SCORE=0.30
AI_RAG_VECTOR_CANDIDATE_K=12
AI_RAG_VECTOR_SEMANTIC_WEIGHT=0.85
AI_EMBEDDING_CACHE_ENABLED=true
AI_EMBEDDING_CACHE_TTL=600

# P1 vector retrieval (set true only after Qdrant and the embedding provider are configured)
AI_RAG_VECTOR_ENABLED=false
AI_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=farmer_ic_knowledge
QDRANT_API_KEY=
